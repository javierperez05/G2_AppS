<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44C4BCFF">

    <!-- Halo exterior difuso -->
    <item android:id="@android:id/background">
        <layer-list>

            <item android:left="-4dp" android:top="-4dp" android:right="-4dp" android:bottom="-4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="34dp" />
                    <solid android:color="#181717AB" />
                </shape>
            </item>

            <!-- Cuerpo con gradiente -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="28dp" />
                    <gradient
                        android:startColor="#1717AB"
                        android:centerColor="#2E21C7"
                        android:endColor="#5B2FE8"
                        android:angle="135" />
                    <stroke
                        android:width="1dp"
                        android:color="#44C4BCFF" />
                </shape>
            </item>

        </layer-list>
    </item>

</ripple>
