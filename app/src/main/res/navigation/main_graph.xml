<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/navigation_home">

    <!-- EventFragment — pantalla principal de eventos -->
    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.cosmos.ui.Events.EventFragment"
        android:label="fragment_event"
        tools:layout="@layout/fragment_event">

        <action
            android:id="@+id/action_eventFragment_to_createEventFragment"
            app:destination="@id/createEventFragment" />

        <action
            android:id="@+id/action_eventFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />

    </fragment>

    <!-- CreateEventFragment -->
    <fragment
        android:id="@+id/createEventFragment"
        android:name="com.example.cosmos.ui.Events.rvEvents.CreateEventFragment"
        android:label="CreateEventFragment" />

    <!-- EventDetailFragment -->
    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="com.example.cosmos.ui.Events.EventDetailFragment"
        android:label="fragment_event_detail"
        tools:layout="@layout/fragment_event_detail">

        <action
            android:id="@+id/action_eventDetailFragment_to_createEventFragment"
            app:destination="@id/createEventFragment" />

    </fragment>

    <!-- NewsFragment -->
    <fragment
        android:id="@+id/navigation_news"
        android:name="com.example.cosmos.ui.News.NewsFragment"
        android:label="fragment_news"
        tools:layout="@layout/fragment_news">

        <action
            android:id="@+id/action_newsFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />

    </fragment>

    <!-- GroupFragment — órbitas -->
    <fragment
        android:id="@+id/navigation_orbit"
        android:name="com.example.cosmos.ui.Orbit.GroupFragment"
        android:label="fragment_group"
        tools:layout="@layout/fragment_group">

        <action
            android:id="@+id/action_groupFragment_to_groupDetailFragment"
            app:destination="@id/groupDetailFragment" />

        <action
            android:id="@+id/action_groupFragment_to_createGroupFragment"
            app:destination="@id/createGroupFragment" />

    </fragment>

    <!-- CreateGroupFragment -->
    <fragment
        android:id="@+id/createGroupFragment"
        android:name="com.example.cosmos.ui.Orbit.CreateGroupFragment"
        android:label="CreateGroupFragment" />

    <!-- GroupDetailFragment -->
    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.example.cosmos.ui.Orbit.Detail.GroupDetailFragment"
        android:label="fragment_group_detail"
        tools:layout="@layout/fragment_group_detail">

        <action
            android:id="@+id/action_groupDetailFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />

        <action
            android:id="@+id/action_groupDetailFragment_to_createEventFragment"
            app:destination="@id/createEventFragment" />

    </fragment>

    <!-- ProfileFragment -->
    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.cosmos.ui.Profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_configFragment"
            app:destination="@id/configFragment" />

        <action
            android:id="@+id/action_profileFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />

    </fragment>

    <!-- ConfigFragment -->
    <fragment
        android:id="@+id/configFragment"
        android:name="com.example.cosmos.ui.Profile.Config.ConfigFragment"
        android:label="fragment_config"
        tools:layout="@layout/fragment_config" />

</navigation>