<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#12FFFFFF">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- MY POST: photo left, info right -->
        <LinearLayout
            android:id="@+id/layoutPostMine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Photo placeholder -->
            <ImageView
                android:id="@+id/ivPhotoMine"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="#22FFFFFF" />

            <!-- Info panel -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="start">

                <TextView
                    android:id="@+id/tvUsernameMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#22FFFFFF" />

                <!-- Stars -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStarsMine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRatingMine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#AAFFFFFF"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Comment -->
                <TextView
                    android:id="@+id/tvCommentMine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#15FFFFFF" />

                <!-- Crew label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRIPULACION"
                    android:textColor="#44FFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvCrewMine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.3" />

                <!-- Ver mision button -->
                <TextView
                    android:id="@+id/btnViewEventMine"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip_glass"
                    android:gravity="center"
                    android:text="VER MISION ▸"
                    android:textColor="#AAFFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.10" />

            </LinearLayout>

        </LinearLayout>

        <!-- OTHER'S POST: info left, photo right -->
        <LinearLayout
            android:id="@+id/layoutPostOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Info panel -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="start">

                <TextView
                    android:id="@+id/tvUsernameOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#22FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStarsOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRatingOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#AAFFFFFF"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCommentOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#15FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRIPULACION"
                    android:textColor="#44FFFFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvCrewOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:id="@+id/btnViewEventOther"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip_glass"
                    android:gravity="center"
                    android:text="VER MISION ▸"
                    android:textColor="#AAFFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.10" />

            </LinearLayout>

            <!-- Photo placeholder -->
            <ImageView
                android:id="@+id/ivPhotoOther"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="#22FFFFFF" />

        </LinearLayout>

        <!-- Footer: event title + time ago (always visible) -->
        <LinearLayout
            android:id="@+id/layoutFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="#33000000">

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#AAFFFFFF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvTimeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#55FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
