<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#12FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Carousel de fotos (visible solo si hay imágenes) ── -->
        <FrameLayout
            android:id="@+id/frameCarousel"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:visibility="gone">

            <!-- Páginas de imágenes -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPhotos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" />

            <!-- Contador "2 / 5" en esquina superior derecha -->
            <TextView
                android:id="@+id/tvPhotoCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="#66000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Indicador de dots en la parte inferior -->
            <LinearLayout
                android:id="@+id/llDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:visibility="gone" />

        </FrameLayout>

        <!-- ── Cabecera: avatar + username ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp">

            <!-- MY POST — alineado a la izquierda (siempre visible en este bloque) -->
            <LinearLayout
                android:id="@+id/layoutPostMine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatarMine"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_circle_profile"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"
                    app:strokeWidth="1dp"
                    app:strokeColor="#33FFFFFF" />

                <TextView
                    android:id="@+id/tvUsernameMine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Stars inline -->
                <TextView
                    android:id="@+id/tvStarsMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRatingMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#AAFFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- OTHER'S POST -->
            <LinearLayout
                android:id="@+id/layoutPostOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatarOther"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_circle_profile"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"
                    app:strokeWidth="1dp"
                    app:strokeColor="#33FFFFFF" />

                <TextView
                    android:id="@+id/tvUsernameOther"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStarsOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRatingOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#AAFFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Cuerpo ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- Comentario -->
            <TextView
                android:id="@+id/tvCommentMine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:maxLines="4"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- (alias para other — mismo ID region, solo uno visible) -->
            <TextView
                android:id="@+id/tvCommentOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:maxLines="4"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Item summary -->
            <TextView
                android:id="@+id/tvItemSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:drawablePadding="6dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#15FFFFFF" />

            <!-- Crew label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRIPULACION"
                android:textColor="#44FFFFFF"
                android:textSize="9sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvCrewMine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCrewOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone" />

            <!-- Footer row: event title + time ago -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvEventTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#44FFFFFF"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/btnViewEventMine"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_glass"
                    android:gravity="center"
                    android:text="VER ▸"
                    android:textColor="#AAFFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.10"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnViewEventOther"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_glass"
                    android:gravity="center"
                    android:text="VER ▸"
                    android:textColor="#AAFFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.10"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnProponerMine"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_glass"
                    android:gravity="center"
                    android:text="PROPONER +"
                    android:textColor="#AAC4BCFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.10"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnProponerOther"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_glass"
                    android:gravity="center"
                    android:text="PROPONER +"
                    android:textColor="#AAC4BCFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.10"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
