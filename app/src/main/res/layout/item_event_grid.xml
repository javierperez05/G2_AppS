<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#1A1A1E">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Spacer 1:1 -->
        <View
            android:id="@+id/viewRatioSpacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1" />

        <!-- Imagen de fondo del evento -->
        <ImageView
            android:id="@+id/ivGridBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_circle_profile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/viewRatioSpacer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Overlay gradiente oscuro (transparente arriba → oscuro abajo) -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_grid_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/viewRatioSpacer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Badge de estado: ACTIVO / TERMINADO — esquina superior izquierda -->
        <TextView
            android:id="@+id/tvGridBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:background="@drawable/bg_chip_glass"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Título del evento — parte inferior -->
        <TextView
            android:id="@+id/tvGridEventTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#EEFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="@id/viewRatioSpacer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvGridEventDate" />

        <!-- Fecha — esquina inferior derecha -->
        <TextView
            android:id="@+id/tvGridEventDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#88FFFFFF"
            android:textSize="8sp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp"
            app:layout_constraintBottom_toBottomOf="@id/viewRatioSpacer"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
