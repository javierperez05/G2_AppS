<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#12FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Cabecera: emoji + titulo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNewsEmoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="&#128640;"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNewsEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#EEFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvNewsEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Ubicacion -->
        <TextView
            android:id="@+id/tvNewsEventLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#55FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#1AFFFFFF" />

        <!-- Resumen de valoraciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvAvgStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFD700"
                android:textSize="20sp"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvAvgRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRateCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="#55FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Preview de comentarios (se puebla dinamicamente) -->
        <LinearLayout
            android:id="@+id/llComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Seccion: valorar (visible si aun no ha valorado) -->
        <LinearLayout
            android:id="@+id/layoutRateSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="14dp"
                android:background="#1AFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="TU VALORACION"
                android:textColor="#55FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.14" />

            <!-- Selector de estrellas -->
            <LinearLayout
                android:id="@+id/llStarSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView android:layout_width="38dp" android:layout_height="38dp"
                    android:gravity="center" android:text="&#9734;" android:textSize="24sp"
                    android:textColor="#44FFFFFF" android:clickable="true" android:focusable="true" />
                <TextView android:layout_width="38dp" android:layout_height="38dp"
                    android:gravity="center" android:text="&#9734;" android:textSize="24sp"
                    android:textColor="#44FFFFFF" android:clickable="true" android:focusable="true" />
                <TextView android:layout_width="38dp" android:layout_height="38dp"
                    android:gravity="center" android:text="&#9734;" android:textSize="24sp"
                    android:textColor="#44FFFFFF" android:clickable="true" android:focusable="true" />
                <TextView android:layout_width="38dp" android:layout_height="38dp"
                    android:gravity="center" android:text="&#9734;" android:textSize="24sp"
                    android:textColor="#44FFFFFF" android:clickable="true" android:focusable="true" />
                <TextView android:layout_width="38dp" android:layout_height="38dp"
                    android:gravity="center" android:text="&#9734;" android:textSize="24sp"
                    android:textColor="#44FFFFFF" android:clickable="true" android:focusable="true" />

            </LinearLayout>

            <!-- Campo comentario -->
            <EditText
                android:id="@+id/etRateComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field_glass"
                android:hint="Deja un comentario (opcional)"
                android:textColor="@android:color/white"
                android:textColorHint="#44FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minLines="1"
                android:layout_marginBottom="10dp" />

            <!-- Boton enviar -->
            <TextView
                android:id="@+id/btnSubmitRate"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:text="ENVIAR VALORACION"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

        </LinearLayout>

        <!-- Seccion: mi valoracion (visible si ya valoró) -->
        <LinearLayout
            android:id="@+id/layoutMyRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="#1AFFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TU NOTA"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/tvMyRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvMyComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
