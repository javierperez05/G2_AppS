<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_friend.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <!-- Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivFriendAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_circle_profile"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF" />

    <!-- Nombre -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvFriendUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EEFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFriendEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#55FFFFFF"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Boton accion principal (Añadir / Pendiente / Amigo) -->
    <TextView
        android:id="@+id/btnFriendAction"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingHorizontal="14dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_chip_glass"
        android:textColor="#AAFFFFFF" />

    <!-- Botones de solicitud (solo visibles para incoming requests) -->
    <LinearLayout
        android:id="@+id/layoutRequestActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnAccept"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:text="@string/btn_accept"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_selected"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/btnReject"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:text="@string/confirm_reject_btn"
            android:textSize="12sp"
            android:background="@drawable/bg_chip_glass"
            android:textColor="#88FFFFFF" />

    </LinearLayout>

</LinearLayout>
