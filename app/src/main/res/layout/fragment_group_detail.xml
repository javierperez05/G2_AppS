<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cosmos">

    <!-- Botón volver -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_chip_glass"
        android:src="@drawable/ic_arrow_back"
        android:padding="8dp"
        android:contentDescription="Volver"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Barra de acciones inferior -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#CC191A1C"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnInvite"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_glass"
            android:gravity="center"
            android:text="+ INVITAR"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnCreateEvent"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:text="+ MISION"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnLeaveGroup"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_glass"
            android:gravity="center"
            android:text="SALIR"
            android:textColor="#FF6B6B"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Contenido principal desplazable -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/layoutActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Cabecera del grupo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivGroupImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_circle_profile"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"
                app:strokeWidth="2dp"
                app:strokeColor="@color/app_color" />

            <TextView
                android:id="@+id/tvGroupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="24dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvGroupDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="32dp"
                android:textSize="13sp"
                android:textColor="#88FFFFFF"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGroupMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:textColor="#55FFFFFF"
                android:letterSpacing="0.08" />

            <!-- Banner de invitación (solo visible si el usuario está invitado) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInviteBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1717AB"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Has sido invitado a unirte"
                        android:textColor="#BBFFFFFF"
                        android:textSize="13sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/btnAcceptInvite"
                            android:layout_width="120dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tab_selected"
                            android:gravity="center"
                            android:text="ACEPTAR"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnRejectInvite"
                            android:layout_width="120dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_chip_glass"
                            android:gravity="center"
                            android:text="RECHAZAR"
                            android:textColor="#88FFFFFF"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Tabs MISIONES / TRIPULACIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_tab_container">

                <TextView
                    android:id="@+id/chipMissions"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="MISIONES"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:background="@drawable/bg_tab_selected"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/chipMembers"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="TRIPULACIÓN"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:background="@android:color/transparent"
                    android:textColor="#66FFFFFF" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="2dp"
                android:background="#1AFFFFFF" />

            <!-- Lista de misiones -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGroupEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Lista de miembros -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGroupMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Estado vacío -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin misiones en esta órbita"
                    android:textSize="14sp"
                    android:textColor="#BBBBBB" />

            </LinearLayout>

            <!-- Loading -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:visibility="visible"
                app:indicatorColor="@color/app_color" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
