<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_alert_item"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Accent bar coloreada por tipo -->
    <View
        android:id="@+id/viewAccent"
        android:layout_width="4dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_alert_accent" />

    <!-- Icono con fondo circular -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp">

        <View
            android:id="@+id/viewIconBg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_alert_icon_circle" />

        <ImageView
            android:id="@+id/ivAlertIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/content_desc_alerts"
            tools:src="@drawable/ic_rocket" />

    </FrameLayout>

    <!-- Textos -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAlertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#EEFFFFFF"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvAlertSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:textColor="#55FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Time chip -->
    <TextView
        android:id="@+id/tvAlertTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_alert_time_chip"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#AAFFFFFF"
        android:visibility="gone"
        tools:text="2h 30m"
        tools:visibility="visible" />

    <!-- Dismiss button -->
    <ImageView
        android:id="@+id/btnDismiss"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/btn_clear"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:visibility="gone" />

</LinearLayout>
