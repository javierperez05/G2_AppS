<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cosmos">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_glass"
            android:src="@drawable/ic_arrow_back"
            android:padding="10dp"
            app:tint="#CCFFFFFF" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="#EEFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Edit button — solo visible para admins -->
        <ImageButton
            android:id="@+id/btnEditEvent"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_glass"
            android:src="@drawable/ic_edit"
            android:padding="8dp"
            android:visibility="gone"
            app:tint="#AAFFFFFF" />

        <!-- Delete button — solo visible para admins -->
        <ImageButton
            android:id="@+id/btnDeleteEvent"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_glass"
            android:src="@drawable/ic_delete"
            android:padding="8dp"
            android:visibility="gone"
            app:tint="#AAFFFFFF" />

    </LinearLayout>

    <!-- Loading global -->
    <ProgressBar
        android:id="@+id/progressGlobal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="visible" />

    <!-- Contenido desplazable -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Banner invitación pendiente -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPendingInvite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#221717AB"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvPendingInviteLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TE HAN INVITADO A ESTA MISION"
                        android:textColor="#C4BCFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/btnRejectInvite"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_chip_glass"
                            android:gravity="center"
                            android:text="RECHAZAR"
                            android:textColor="#88FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/btnAcceptInvite"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tab_selected"
                            android:gravity="center"
                            android:text="UNIRSE"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card info del evento -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#12FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Imagen del evento (visible solo si existe) -->
                    <ImageView
                        android:id="@+id/ivEventImage"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="16dp"
                        android:scaleType="centerCrop"
                        android:background="#1AFFFFFF"
                        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium"
                        android:visibility="gone" />

                    <!-- Emoji + titulo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvEventEmoji"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:textSize="28sp"
                            android:text="&#128640;" />

                        <TextView
                            android:id="@+id/tvEventTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:textColor="@android:color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#1AFFFFFF" />

                    <!-- Fecha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_calendar"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/app_color" />

                        <TextView
                            android:id="@+id/tvEventDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#AAFFFFFF"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Ubicacion -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_map_pin"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/app_color" />

                        <TextView
                            android:id="@+id/tvEventLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#AAFFFFFF"
                            android:textSize="13sp" />

                        <ImageButton
                            android:id="@+id/btnOpenMap"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_chip_glass"
                            android:src="@drawable/ic_map_pin"
                            android:padding="7dp"
                            android:visibility="gone"
                            app:tint="#AAC4BCFF" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMapAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="26dp"
                        android:layout_marginTop="2dp"
                        android:textColor="#55FFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <!-- Descripcion -->
                    <TextView
                        android:id="@+id/tvEventDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#88FFFFFF"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#1AFFFFFF" />

                    <!-- Tripulacion -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TRIPULACION"
                            android:textColor="#55FFFFFF"
                            android:textSize="10sp"
                            android:letterSpacing="0.12" />

                        <TextView
                            android:id="@+id/tvMemberCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#AAFFFFFF"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEventMembers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:overScrollMode="never"
                        android:clipToPadding="false" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card equipamiento (items) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#12FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:background="@color/app_color" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="EQUIPAMIENTO"
                            android:textColor="#AAFFFFFF"
                            android:textSize="11sp"
                            android:letterSpacing="0.14" />

                        <TextView
                            android:id="@+id/btnAddItem"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/app_color"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_chip_glass" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#1AFFFFFF" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tvEmptyItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:text="Sin items aun. Pulsa + para añadir."
                        android:textColor="#44FFFFFF"
                        android:textSize="12sp"
                        android:visibility="visible" />

                    <!-- Total -->
                    <View
                        android:id="@+id/dividerTotal"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="#1AFFFFFF"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="10dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL"
                            android:textColor="#AAFFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.10" />

                        <TextView
                            android:id="@+id/tvItemsTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#EEFFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card cuentas (settlements) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSettlements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#121717AB"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:background="@color/app_color" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CUENTAS"
                            android:textColor="#AAFFFFFF"
                            android:textSize="11sp"
                            android:letterSpacing="0.14" />

                    </LinearLayout>

                    <!-- Filas de deudas generadas dinamicamente -->
                    <LinearLayout
                        android:id="@+id/layoutSettlements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Banner duracion -->
            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_chip_glass"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Boton finalizar mision (solo admin, cuando ha pasado la duracion) -->
            <TextView
                android:id="@+id/btnFinishEvent"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:text="FINALIZAR MISION"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:visibility="gone" />

            <!-- Banner mision finalizada + boton valorar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFinished"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1717AB"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MISION COMPLETADA"
                        android:textColor="#AAFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14" />

                    <TextView
                        android:id="@+id/btnRate"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_tab_selected"
                        android:gravity="center"
                        android:text="VALORAR MISION"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvAlreadyRated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ya has valorado esta mision"
                        android:textColor="#55FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnPublishPost"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chip_glass"
                        android:gravity="center"
                        android:text="PUBLICAR EN NEWS"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvAlreadyPosted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ya publicaste esta mision"
                        android:textColor="#55FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Cabecera foro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/app_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TRANSMISIONES"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/tvThreadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#55FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Cargando hilos -->
            <ProgressBar
                android:id="@+id/progressThreads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <!-- Sin transmisiones -->
            <TextView
                android:id="@+id/tvEmptyThreads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="24dp"
                android:text="Se el primero en transmitir algo"
                android:textColor="#44FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Lista de hilos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvThreads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Barra inferior (contexto de respuesta + input) -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Contexto de respuesta (visible solo al responder) -->
        <LinearLayout
            android:id="@+id/layoutReplyContext"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#1AFFFFFF"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReplyContext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#AAFFFFFF"
                android:textSize="11sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btnCancelReply"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#66FFFFFF" />

        </LinearLayout>

        <!-- Input -->
        <LinearLayout
            android:id="@+id/layoutInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/background">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_field_glass"
                android:hint="Transmite algo..."
                android:textColor="@android:color/white"
                android:textColorHint="#44FFFFFF"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minLines="1" />

            <TextView
                android:id="@+id/btnSend"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_glass"
                android:gravity="center"
                android:text="&#10148;"
                android:textColor="@color/app_color"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
