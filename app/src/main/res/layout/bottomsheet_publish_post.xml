<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_cosmos"
    android:paddingBottom="24dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#44FFFFFF"
        android:backgroundTint="#44FFFFFF" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/publish_transmission"
            android:textColor="#EEFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/btnPublish"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="20dp"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:text="@string/btn_publish"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Rating del usuario (read-only) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvPostStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvPostRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPostEventTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="#55FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end" />

    </LinearLayout>

    <!-- Campo de texto del post -->
    <EditText
        android:id="@+id/etPostComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_field_glass"
        android:hint="@string/hint_post_comment"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="3"
        android:maxLines="6"
        android:gravity="top"
        android:textColor="#EEFFFFFF"
        android:textColorHint="#44FFFFFF"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp" />

    <!-- Controles de visibilidad -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/label_include_in_post"
        android:textColor="#55FFFFFF"
        android:textSize="10sp"
        android:letterSpacing="0.12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/chipShowLocation"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:text="@string/chip_location"
            android:textSize="11sp"
            android:textColor="#88FFFFFF"
            android:background="@drawable/bg_chip_glass"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipShowDescription"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:text="@string/chip_description"
            android:textSize="11sp"
            android:textColor="#88FFFFFF"
            android:background="@drawable/bg_chip_glass"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipShowItems"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:text="@string/chip_items"
            android:textSize="11sp"
            android:textColor="#88FFFFFF"
            android:background="@drawable/bg_chip_glass" />

    </LinearLayout>

    <!-- Fotos añadidas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/label_photos"
        android:textColor="#55FFFFFF"
        android:textSize="10sp"
        android:letterSpacing="0.12" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/llPhotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Botón añadir foto -->
            <FrameLayout
                android:id="@+id/btnAddPhoto"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_field_glass"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add_image"
                    app:tint="@color/app_color" />

            </FrameLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Loading indicator -->
    <LinearLayout
        android:id="@+id/layoutPublishing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            app:indicatorColor="@color/app_color"
            app:trackCornerRadius="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/publishing"
            android:textColor="#88FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
