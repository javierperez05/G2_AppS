<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_glass" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_alert_sheet_header">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_signal"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/content_desc_alerts" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transmission_log"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#77FFFFFF"
            android:letterSpacing="0.2" />

        <!-- Count badge -->
        <TextView
            android:id="@+id/tvAlertCount"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:minWidth="22dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_alert_count_badge"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CC7C6DF0"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_glass"
            android:text="@string/btn_clear"
            android:textSize="10sp"
            android:textColor="#55FFFFFF"
            android:letterSpacing="0.08"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#0CFFFFFF" />

    <!-- Alert list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutNoAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_signal"
            android:alpha="0.2"
            android:contentDescription="@string/no_transmissions_alerts" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/no_transmissions_alerts"
            android:textSize="13sp"
            android:textColor="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/alert_empty_subtitle"
            android:textSize="11sp"
            android:textColor="#22FFFFFF" />

    </LinearLayout>

</LinearLayout>
