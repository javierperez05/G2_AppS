<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1F22">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#44FFFFFF" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvProposeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:text="@string/propose_mission"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/tvProposeEventName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Tabs: ÓRBITAS / AMIGOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/chipProposeGroups"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/chip_orbits"
            android:textColor="#FFC4BCFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipProposeAmigos"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_glass"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/chip_friends"
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Loading -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressPropose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="24dp"
        android:visibility="gone"
        app:indicatorColor="@color/app_color" />

    <!-- Empty message -->
    <TextView
        android:id="@+id/tvProposeEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp"
        android:gravity="center"
        android:text="@string/no_orbits_yet"
        android:textColor="#55FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Scrollable list of items -->
    <ScrollView
        android:id="@+id/scrollPropose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llProposeItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />

    </ScrollView>

</LinearLayout>
