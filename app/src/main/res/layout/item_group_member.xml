<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivMemberAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_circle_profile"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvMemberUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EEFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMemberBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnKick"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:text="Expulsar"
        android:textSize="11sp"
        android:textColor="#88FFFFFF"
        android:background="@drawable/bg_chip_glass"
        android:visibility="gone" />

</LinearLayout>
